[
    {
        "id": "mqtt_in",
        "type": "mqtt in",
        "z": "flow1",
        "name": "Telemetry",
        "topic": "iiot/condition-monitoring/telemetry",
        "qos": "1",
        "datatype": "auto",
        "broker": "mqtt_broker",
        "x": 180,
        "y": 180,
        "wires": [["json_node"]]
    },
    {
        "id": "json_node",
        "type": "json",
        "z": "flow1",
        "name": "Parse JSON",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 390,
        "y": 180,
        "wires": [["temp_gauge", "current_gauge", "vibration_gauge"]]
    },
    {
        "id": "temp_gauge",
        "type": "ui_gauge",
        "z": "flow1",
        "name": "Temperature",
        "group": "dashboard_group",
        "order": 1,
        "width": 6,
        "height": 4,
        "gtype": "gage",
        "title": "Temperature",
        "label": "°C",
        "format": "{{payload.temperature}}",
        "min": 0,
        "max": 100,
        "x": 690,
        "y": 120,
        "wires": []
    },
    {
        "id": "current_gauge",
        "type": "ui_gauge",
        "z": "flow1",
        "name": "Current",
        "group": "dashboard_group",
        "order": 2,
        "width": 6,
        "height": 4,
        "gtype": "gage",
        "title": "Current",
        "label": "A",
        "format": "{{payload.current}}",
        "min": 0,
        "max": 20,
        "x": 680,
        "y": 180,
        "wires": []
    },
    {
        "id": "vibration_gauge",
        "type": "ui_gauge",
        "z": "flow1",
        "name": "Vibration",
        "group": "dashboard_group",
        "order": 3,
        "width": 6,
        "height": 4,
        "gtype": "gage",
        "title": "Vibration",
        "label": "g",
        "format": "{{payload.vibration}}",
        "min": 0,
        "max": 5,
        "x": 690,
        "y": 240,
        "wires": []
    },
    {
        "id": "mqtt_broker",
        "type": "mqtt-broker",
        "name": "HiveMQ",
        "broker": "",
        "port": "8883",
        "clientid": "",
        "usetls": true,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "dashboard_group",
        "type": "ui_group",
        "name": "Machine Status",
        "tab": "dashboard_tab",
        "order": 1,
        "disp": true,
        "width": "12"
    },
    {
        "id": "dashboard_tab",
        "type": "ui_tab",
        "name": "IIoT Dashboard",
        "icon": "dashboard",
        "order": 1
    }
]