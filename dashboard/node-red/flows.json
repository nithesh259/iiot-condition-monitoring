    {
        "id": "8a292f974f07e3ce",
        "type": "function",
        "z": "5c9e0dff8ed3afb2",
        "name": "Machine status",
        "func": "let t = msg.payload.temperature;\nlet c = msg.payload.current;\nlet v = msg.payload.vibration;\n\nif (t > 35 || v > 0.40) {\n    msg.payload = \"🔴 FAULT\";\n} else if (t > 30 || v > 0.25) {\n    msg.payload = \"🟡 WARNING\";\n} else {\n    msg.payload = \"🟢 RUNNING\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
